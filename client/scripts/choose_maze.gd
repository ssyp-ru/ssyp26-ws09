var mat_size : int

var list_of_mazes: Array
var global_button_index = 1

var current_page = 0
var pages = 1
var static_buttons = []

var white_squares : Array[Vector2] = []
var black_squares : Array[Vector2] = []


@onready var grid_container: GridContainer = $VBoxContainer/GridContainer
@onready var previous: Button = $VBoxContainer/HBoxContainer/previous
@onready var next: Button = $VBoxContainer/HBoxContainer/next
@onready var label: Label = $VBoxContainer/HBoxContainer/Label
@onready var preview_menu: GridContainer = $GridContainer
@onready var preview_png: Control = $GridContainer/PanelContainer/Control


func _ready() -> void:
	preview_png.draw.connect(_on_preview_png_draw)
	preview_png.queue_redraw()
	
	SceneManager.mazes_list_updated.connect(_on_mazes_list_updated)
	SceneManager.maze_data_load.connect(_on_maze_data_load)
	
	static_buttons = grid_container.get_children()
	
	var buttons_to_bind = min(static_buttons.size(), Buttons_Per_Page)
	
	previous.pressed.connect(_on_prev_pressed)
	next.pressed.connect(_on_next_pressed)
	
	for i in range(buttons_to_bind):
		var btn = static_buttons[i] as Button
		if btn:
			btn.pressed.connect(_on_button_pressed.bind(i))
	
	preview_menu.hide()

func set_list_of_mazes():
	list_of_mazes = SceneManager.mazes_list

func update_total_pages() -> void:
	pages = int(ceil(float(list_of_mazes.size()) / Buttons_Per_Page))
	pages = max(1, pages)

func _on_mazes_list_updated(updated: bool):
	list_of_mazes = SceneManager.mazes_list
	
	update_total_pages()
	refresh_page()

func refresh_page() -> void:
	var page_start_index = current_page * Buttons_Per_Page
	
	for i in range(Buttons_Per_Page):
		if i >= static_buttons.size():
			break
		
		var btn = static_buttons[i] as Button
		
		if not btn:
			continue
			
		var global_lab_index = page_start_index + i
		
		if global_lab_index <= list_of_mazes.size():
			btn.text = list_of_mazes[global_lab_index]
			btn.show()
		else:
			btn.hide()
	
	label.text = "%d/%d" % [current_page + 1, pages]
	
	if current_page <= 0:
		previous.disabled = true
		
	if current_page >= pages - 1:
		next.disabled = true
		
	if previous.disabled and current_page > 0:
		previous.disabled = false
		
	if next.disabled and current_page < pages - 1:
		next.disabled = false


func _on_button_pressed(button_index : int) -> void:
	global_button_index = (current_page * Buttons_Per_Page) + button_index

	var maze_id = list_of_mazes[global_button_index]
	
	SceneManager.send_command({"command": "get_maze", "maze_id": maze_id})


func _on_maze_data_load(data: Dictionary) -> void:
	var mat = data.get("mat")
	mat_size = mat.size()
	
	white_squares.clear()
	black_squares.clear()
	
	for i in range(mat_size):
		for j in range(mat_size):
			if mat[i][j] == 0:
				_draw_white(i, j)
			if mat[i][j] == 1:
				_draw_black(i, j)
	
	preview_menu.visible = !preview_menu.visible

func _on_prev_pressed() -> void:
	if current_page > 0:
		current_page -= 1
		preview_menu.hide()
		refresh_page()

func _on_next_pressed() -> void:
	if current_page < pages - 1:
		current_page += 1
		preview_menu.hide()
		refresh_page()


func _draw_white(x, y) -> void:
	white_squares.append(Vector2(x, y))
	preview_png.queue_redraw()


func _draw_black(x, y) -> void:
	black_squares.append(Vector2(x, y))
	preview_png.queue_redraw()


func _on_preview_png_draw() -> void:
	var size = Vector2(320 / mat_size, 320 / mat_size)
	
	for point in black_squares:
		var rect = Rect2(point * 320 / mat_size, size)
		preview_png.draw_rect(rect, Color.BLACK)
		
	for point in white_squares:
		var rect = Rect2(point * 320 / mat_size, size)
		preview_png.draw_rect(rect, Color.WHITE)
